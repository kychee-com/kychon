      "file": "capture-screenshots.sh",
      "data": "#!/usr/bin/env zsh\n# ============================================\n# Capture showcase screenshots for marketing site\n# Uses Chrome headless mode (no dependencies needed)\n#\n# Usage:\n#   ./marketing/capture-screenshots.sh          # all sites\n#   ./marketing/capture-screenshots.sh eagles   # just eagles\n# ============================================\n\nset -e\n\nSCRIPT_DIR=\"${0:a:h}\"\nASSETS_DIR=\"$SCRIPT_DIR/assets\"\nmkdir -p \"$ASSETS_DIR\"\n\n# Find Chrome\nif [[ -d \"/Applications/Google Chrome.app\" ]]; then\n  CHROME=\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\"\nelif (( $+commands[google-chrome] )); then\n  CHROME=\"google-chrome\"\nelif (( $+commands[chromium] )); then\n  CHROME=\"chromium\"\nelse\n  echo \"Chrome not found. Install Google Chrome.\"\n  exit 1\nfi\n\nWIDTH=1280\nHEIGHT=800\n\ncapture() {\n  local name=\"$1\"\n  local url=\"$2\"\n  local output=\"$ASSETS_DIR/screenshot-${name}.png\"\n\n  echo \"Capturing $name ($url)...\"\n  # Use a small HTML page that navigates to the URL, waits for JS to render, then screenshots\n  local tmphtml=$(mktemp /tmp/capture-XXXXXX.html)\n  cat > \"$tmphtml\" <<HTMLEOF\n<!DOCTYPE html>\n<html><body><script>\n  // Navigate and wait for content to load\n  window.location = '$url';\n</script></body></html>\nHTMLEOF\n\n  # Use virtual-time-budget to let JS execute (5 seconds of simulated time)\n  \"$CHROME\" \\\n    --headless=new \\\n    --disable-gpu \\\n    --no-sandbox \\\n    --hide-scrollbars \\\n    --window-size=\"${WIDTH},${HEIGHT}\" \\\n    --virtual-time-budget=8000 \\\n    --screenshot=\"$output\" \\\n    \"$url\" \\\n    2>/dev/null\n\n  rm -f \"$tmphtml\"\n\n  if [[ -f \"$output\" ]]; then\n    local size=$(du -h \"$output\" | cut -f1)\n    echo \"  Saved: $output ($size)\"\n  else\n    echo \"  FAILED: $output not created\"\n  fi\n}\n\n# Showcase sites — add more as they're created\ntypeset -A SITES\nSITES=(\n  eagles          \"https://eagles.run402.com\"\n  eagles-directory \"https://eagles.run402.com/directory.html\"\n  eagles-events   \"https://eagles.run402.com/events.html\"\n  eagles-forum    \"https://eagles.run402.com/forum.html\"\n)\n\nif [[ -n \"$1\" ]]; then\n  if [[ -n \"${SITES[$1]}\" ]]; then\n    capture \"$1\" \"${SITES[$1]}\"\n  else\n    echo \"Unknown site: $1\"\n    echo \"Available: ${(k)SITES}\"\n    exit 1\n  fi\nelse\n  for name url in \"${(@kv)SITES}\"; do\n    capture \"$name\" \"$url\"\n  done\nfi\n\necho \"Done.\"\n"
    },
    {
      "file": "churches.html",
      "data": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>Wild Lychee for Churches — AI-Powered Community Portal</title>\n  <meta name=\"description\" content=\"A modern church portal with sermon archives, prayer requests, small group management, and multilingual support. $5-20/mo flat. No per-member fees.\">\n  <link rel=\"stylesheet\" href=\"/css/marketing.css\">\n</head>\n<body>\n\n  <!-- ======== NAV ======== -->\n  <nav class=\"nav\">\n    <div class=\"container nav__inner\">\n      <a href=\"/\" class=\"nav__brand\">\n        <span class=\"nav__brand-icon\">&#127819;</span>\n        Wild Lychee\n      </a>\n      <button class=\"nav__toggle\" id=\"nav-toggle\" aria-label=\"Menu\">&#9776;</button>\n      <div class=\"nav__links\" id=\"nav-links\">\n        <a href=\"/\" class=\"nav__link\">&larr; Back to Wild Lychee</a>\n        <a href=\"#features\" class=\"nav__link\">Features</a>\n        <a href=\"#pricing\" class=\"nav__link\">Pricing</a>\n        <a href=\"https://github.com/kychee-com/wildlychee\" class=\"nav__link\" target=\"_blank\">GitHub</a>\n        <a href=\"#demo-placeholder\" class=\"btn btn--primary btn--lg nav__cta\">Try the Demo</a>\n      </div>\n    </div>\n  </nav>\n\n  <!-- ======== HERO ======== -->\n  <section class=\"hero section section--cream section--dotted\">\n    <div class=\"container hero__content\">\n      <p class=\"t-overline mb-2\">Wild Lychee for Churches</p>\n      <h1 class=\"t-display t-display--xl hero__headline\">\n        Your congregation deserves a modern home online.\n      </h1>\n      <p class=\"t-body--lg hero__sub\">\n        Sermon archives, prayer requests, small group sign-ups, youth programs, and multilingual support &mdash; all in one portal your church actually owns. No per-member fees. No lock-in. From <strong style=\"color:var(--ink)\">$5/mo</strong>.\n      </p>\n      <div class=\"hero__ctas\">\n        <a href=\"#demo-placeholder\" class=\"btn btn--primary btn--lg\">Build Your Church Portal &rarr;</a>\n        <a href=\"https://github.com/kychee-com/wildlychee\" class=\"btn btn--outline btn--lg\" target=\"_blank\">Fork on GitHub</a>\n      </div>\n    </div>\n    <div class=\"hero__aside\" aria-hidden=\"true\"></div>\n  </section>\n\n  <!-- ======== FEATURES ======== -->\n  <section class=\"section section--white\" id=\"features\">\n    <div class=\"container\">\n      <div class=\"section-header\">\n        <p class=\"t-overline\">Built for Churches</p>\n        <h2 class=\"t-display t-display--lg\">Everything your congregation needs.</h2>\n        <p class=\"t-body--lg mt-2\">Six church-specific features, ready out of the box. Toggle them on with a config flag.</p>\n      </div>\n\n      <div class=\"feature-grid\">\n        <div class=\"feature-card\">\n          <div class=\"feature-card__icon\">&#128214;</div>\n          <div class=\"feature-card__name\">Sermon Library</div>\n          <div class=\"feature-card__desc\">Archive sermons with audio, video, notes, and scripture references. Searchable by topic, speaker, or date.</div>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-card__icon\">&#128591;</div>\n          <div class=\"feature-card__name\">Prayer Requests</div>\n          <div class=\"feature-card__desc\">Members submit prayer requests with optional privacy settings. Congregation can respond with encouragement.</div>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-card__icon\">&#128101;</div>\n          <div class=\"feature-card__name\">Small Groups</div>\n          <div class=\"feature-card__desc\">Browse, join, and manage small groups with meeting times, locations, leaders, and member lists.</div>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-card__icon\">&#127925;</div>\n          <div class=\"feature-card__name\">Worship Team Resources</div>\n          <div class=\"feature-card__desc\">Sheet music, chord charts, set lists, and rehearsal schedules in a member-only resource library.</div>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-card__icon\">&#127760;</div>\n          <div class=\"feature-card__name\">Multi-Language Support</div>\n          <div class=\"feature-card__desc\">Serve your congregation in multiple languages. Built-in Portuguese/English support with AI-powered translation.</div>\n        </div>\n        <div class=\"feature-card\">\n          <div class=\"feature-card__icon\">&#128197;</div>\n          <div class=\"feature-card__name\">Church Events</div>\n          <div class=\"feature-card__desc\">Sunday services, Bible studies, youth nights, potlucks &mdash; with RSVP tracking, reminders, and capacity limits.</div>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ======== PRICING ======== -->\n  <section class=\"section section--cream section--dotted\" id=\"pricing\">\n    <div class=\"container\">\n      <div class=\"section-header section-header--center\">\n        <p class=\"t-overline\">Pricing</p>\n        <h2 class=\"t-display t-display--lg\">Flat pricing. No per-member fees. Ever.</h2>\n      </div>\n\n      <div class=\"plans-grid\">\n        <div class=\"plan-card\">\n          <div class=\"plan-card__name\">DIY Template</div>\n          <div class=\"plan-card__price\">Free</div>\n          <div class=\"plan-card__price-sub\">+ $5&ndash;20/mo Run402 hosting</div>\n          <div class=\"plan-card__desc\">\"For developers and AI agents.\"</div>\n          <ul class=\"plan-card__features\">\n            <li>Full source code (open source)</li>\n            <li>All features included</li>\n            <li>Self-deploy to Run402</li>\n            <li>Community support</li>\n          </ul>\n          <a href=\"https://github.com/kychee-com/wildlychee\" class=\"btn btn--outline\" target=\"_blank\">Fork on GitHub</a>\n        </div>\n\n        <div class=\"plan-card plan-card--featured\">\n          <div class=\"plan-card__name\">Studio Build</div>\n          <div class=\"plan-card__price\">$29</div>\n          <div class=\"plan-card__price-sub\">one-time + $5&ndash;20/mo hosting</div>\n          <div class=\"plan-card__desc\">\"Tell us about your church. Live in 5 minutes.\"</div>\n          <ul class=\"plan-card__features\">\n            <li>AI investigates your existing site</li>\n            <li>Guided interview &rarr; custom portal</li>\n            <li>Brand colors, logo, content migrated</li>\n            <li>Multi-language translation</li>\n            <li>Chrome-verified deployment</li>\n          </ul>\n          <a href=\"#demo-placeholder\" class=\"btn btn--primary\">Build My Portal &rarr;</a>\n        </div>\n\n        <div class=\"plan-card\">\n          <div class=\"plan-card__name\">Lychee Pro</div>\n          <div class=\"plan-card__price\">$9&ndash;29/mo</div>\n          <div class=\"plan-card__price-sub\">ongoing, cancel anytime</div>\n          <div class=\"plan-card__desc\">\"Your portal evolves with you.\"</div>\n          <ul class=\"plan-card__features\">\n            <li>Ongoing AI customization agent</li>\n            <li>Feature requests via chat</li>\n            <li>Priority support</li>\n            <li>Advanced analytics</li>\n          </ul>\n          <a href=\"#demo-placeholder\" class=\"btn btn--outline\">Learn More</a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <!-- ======== FINAL CTA ======== -->\n  <section class=\"section section--indigo final-cta\">\n    <div class=\"container\">\n      <h2 class=\"t-display t-display--lg\">Give your congregation the home they deserve.</h2>\n      <p class=\"t-body--lg\">Open source. Flat pricing. AI-powered. Yours forever.</p>\n      <div class=\"final-cta__buttons\">\n        <a href=\"#demo-placeholder\" class=\"btn btn--white btn--lg\">Build Your Church Portal &rarr;</a>\n        <a href=\"https://github.com/kychee-com/wildlychee\" class=\"btn btn--outline btn--lg\" style=\"border-color:#fff;color:#fff\" target=\"_blank\">Fork on GitHub</a>\n      </div>\n    </div>\n  </section>\n\n  <!-- ======== FOOTER ======== -->\n  <footer class=\"footer\">\n    <div class=\"container\">\n      <p>\n        <strong>Wild Lychee</strong> is open source. Built on <a href=\"https://run402.com\" target=\"_blank\">Run402</a>.\n        &ensp;&middot;&ensp;\n        <a href=\"https://github.com/kychee-com/wildlychee\" target=\"_blank\">GitHub</a>\n        &ensp;&middot;&ensp;\n        <a href=\"https://eagles.run402.com\" target=\"_blank\">Eagles Demo</a>\n      </p>\n    </div>\n  </footer>\n\n  <!-- Mobile nav toggle -->\n  <script>\n    document.getElementById('nav-toggle')?.addEventListener('click', () => {\n      document.getElementById('nav-links')?.classList.toggle('open');\n    });\n  </script>\n\n</body>\n</html>\n"
    },
