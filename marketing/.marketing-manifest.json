   <span class=\\\\\\\\\\\\\\\"tour-tile__name\\\\\\\\\\\\\\\">Member Directory</span>\\\\\\\\n            <span class=\\\\\\\\\\\\\\\"tour-tile__link\\\\\\\\\\\\\\\">Browse &rarr;</span>\\\\\\\\n          </div>\\\\\\\\n        </a>\\\\\\\\n        <a href=\\\\\\\\\\\\\\\"https://eagles.run402.com/events.html\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"tour-tile\\\\\\\\\\\\\\\">\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"tour-tile__img\\\\\\\\\\\\\\\">\\\\\\\\n            <img src=\\\\\\\\\\\\\\\"/assets/screenshot-eagles-events.png\\\\\\\\\\\\\\\" alt=\\\\\\\\\\\\\\\"Events and RSVP\\\\\\\\\\\\\\\">\\\\\\\\n          </div>\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"tour-tile__body\\\\\\\\\\\\\\\">\\\\\\\\n            <span class=\\\\\\\\\\\\\\\"tour-tile__name\\\\\\\\\\\\\\\">Events &amp; RSVP</span>\\\\\\\\n            <span class=\\\\\\\\\\\\\\\"tour-tile__link\\\\\\\\\\\\\\\">Browse &rarr;</span>\\\\\\\\n          </div>\\\\\\\\n        </a>\\\\\\\\n        <a href=\\\\\\\\\\\\\\\"https://eagles.run402.com/forum.html\\\\\\\\\\\\\\\" target=\\\\\\\\\\\\\\\"_blank\\\\\\\\\\\\\\\" class=\\\\\\\\\\\\\\\"tour-tile\\\\\\\\\\\\\\\">\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"tour-tile__img\\\\\\\\\\\\\\\">\\\\\\\\n            <img src=\\\\\\\\\\\\\\\"/assets/screenshot-eagles-forum.png\\\\\\\\\\\\\\\" alt=\\\\\\\\\\\\\\\"Forum discussions\\\\\\\\\\\\\\\">\\\\\\\\n          </div>\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"tour-tile__body\\\\\\\\\\\\\\\">\\\\\\\\n            <span class=\\\\\\\\\\\\\\\"tour-tile__name\\\\\\\\\\\\\\\">Forum Discussions</span>\\\\\\\\n            <span class=\\\\\\\\\\\\\\\"tour-tile__link\\\\\\\\\\\\\\\">Browse &rarr;</span>\\\\\\\\n          </div>\\\\\\\\n        </a>\\\\\\\\n      </div>\\\\\\\\n    </div>\\\\\\\\n  </section>\\\\\\\\n\\\\\\\\n  <!-- ======== BENEFITS ======== -->\\\\\\\\n  <section class=\\\\\\\\\\\\\\\"section section--cream\\\\\\\\\\\\\\\">\\\\\\\\n    <div class=\\\\\\\\\\\\\\\"container\\\\\\\\\\\\\\\">\\\\\\\\n      <div class=\\\\\\\\\\\\\\\"section-header section-header--center\\\\\\\\\\\\\\\">\\\\\\\\n        <p class=\\\\\\\\\\\\\\\"t-overline\\\\\\\\\\\\\\\">Why Wild Lychee</p>\\\\\\\\n        <h2 class=\\\\\\\\\\\\\\\"t-display t-display--lg\\\\\\\\\\\\\\\">Why organizations choose Wild Lychee.</h2>\\\\\\\\n      </div>\\\\\\\\n\\\\\\\\n      <div class=\\\\\\\\\\\\\\\"benefits-grid\\\\\\\\\\\\\\\">\\\\\\\\n        <div class=\\\\\\\\\\\\\\\"benefit-card\\\\\\\\\\\\\\\">\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__icon\\\\\\\\\\\\\\\">&#128176;</div>\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__title\\\\\\\\\\\\\\\">Predictable cost</div>\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__desc\\\\\\\\\\\\\\\">No per-member fees. $5&ndash;20/mo flat, whether you have 50 members or 5,000. The price scales with your hosting tier, not your headcount.</div>\\\\\\\\n        </div>\\\\\\\\n        <div class=\\\\\\\\\\\\\\\"benefit-card\\\\\\\\\\\\\\\">\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__icon\\\\\\\\\\\\\\\">&#128274;</div>\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__title\\\\\\\\\\\\\\\">You own everything</div>\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__desc\\\\\\\\\\\\\\\">Your data, your branding, your domain. Open source &mdash; fork it, modify it, it's yours. No lock-in, no export fees, no surprises.</div>\\\\\\\\n        </div>\\\\\\\\n        <div class=\\\\\\\\\\\\\\\"benefit-card\\\\\\\\\\\\\\\">\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__icon\\\\\\\\\\\\\\\">&#129302;</div>\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__title\\\\\\\\\\\\\\\">AI does the work</div>\\\\\\\\n          <div class=\\\\\\\\\\\\\\\"benefit-card__desc\\\\\\\\\\\\\\\">Studio builds your portal in 5 minutes. Pro keeps it evolving with ongoing AI customization. Or customize it yourself &mdash; it's just HTML and SQL.</div>\