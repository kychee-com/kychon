---
export const prerender = false;
import { auth } from '@run402/functions';
import { adminGateUnavailableResponse, ssrAdminGate } from '../lib/ssr-db';
import AdminMembersApp from '../components/kychon/AdminMembersApp';
import Portal from '../layouts/Portal.astro';

const user = await auth.user();
if (!user) {
  return Astro.redirect(`/join?returnTo=${encodeURIComponent(Astro.url.pathname)}`, 303);
}
const gate = await ssrAdminGate(user.id);
if (gate === 'unavailable') {
  return adminGateUnavailableResponse();
}
if (gate === 'forbidden') {
  return new Response('Admin access required', { status: 403 });
}
---
<Portal title="Manage Members">
  <AdminMembersApp client:load />
</Portal>
