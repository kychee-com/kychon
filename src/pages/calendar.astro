---
import CalendarPageApp from '../components/kychon/CalendarPageApp';
import Portal from '../layouts/Portal.astro';
import { ssrEventsList } from '../lib/ssr-api';
import { prefetchSsrChrome } from '../lib/ssr-chrome-prefetch';
import { calendarFirstPaintCutoff, calendarFirstPaintEvents } from '../lib/calendar-first-paint';
import type { Event } from '../schemas/event';

// /calendar is per-request — the visitor's current month is implicitly
// "now," so even though `events.list` is the same query every time,
// the calendar grid that wraps it changes day-to-day. SSR'ing eliminates
// the month-grid skeleton flash that hits between hydration and the
// API roundtrip. `events.list` is anonymous-min, so no apikey needed
// (the SSR bundle bakes the role:anon JWT anyway).
//
// Member-only events are RLS-gated out of the anonymous fetch — those
// still surface only via the runtime `loadCalendar` refresh once the
// cookie session is resolved. Member RSVPs (the "going"
// dots on each day cell) are per-user and never come from this SSR
// pass — they're populated in `loadCalendar`'s rsvp side-fetch.
export const prerender = false;

interface EventsListResult {
  rows?: Event[];
}

// The chrome's reads run alongside events.list instead of after it.
prefetchSsrChrome(Astro, 'calendar');
const host = Astro.request.headers.get('host') ?? 'localhost';
const renderedAt = new Date();
// First paint shows only events that have not started (the default filter);
// the island loads the full list right after hydration. Embedding all of a
// port's events (349 for NSGS) made the page 738 KB, and asking the API for
// all of them made events.list the slowest read on a cold render.
const result = await ssrEventsList<EventsListResult>({
  host,
  order: 'starts_at.asc',
  startsAfter: calendarFirstPaintCutoff(renderedAt).toISOString(),
});
const initialEvents = calendarFirstPaintEvents(result?.rows ?? [], renderedAt);
---
<Portal title="Calendar" pageSlug="calendar">
  <CalendarPageApp initialEvents={initialEvents} renderedAt={renderedAt.toISOString()} client:load />
</Portal>
