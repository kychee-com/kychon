---
import EventDetailPageApp from '../components/kychon/EventDetailPageApp';
import Portal from '../layouts/Portal.astro';
import { pickAssetManifestEntries } from '../lib/bake-asset-manifest';
import { eventAssetUrls, eventMetaDescription, eventOgImageUrl } from '../lib/event-meta';
import { ssrAssetManifest, ssrEventGet, ssrRequestOrigin } from '../lib/ssr-api';
import type { Event } from '../schemas/event';

// /event?id=N is per-request: the event comes from the query string, which a
// static build can't see. The requested event is read server-side with the
// anonymous `events.get`, so the raw HTML carries its title, date and
// description (no-JS clients, link previews, the concierge parity harness)
// and the island hydrates from that one event instead of a build-time map of
// every event.
//
// The island still refetches after mount: RSVPs and registration options,
// the visitor's locale, admin edits, and members-only events. Those are
// hidden from the anonymous read, which can't distinguish them from
// nonexistent ids, so both answer 404 + noindex while still serving the
// shell; a signed-in member's island then loads the event as before. A
// failed read (`error`) is not a 404: the shell renders and the island
// retries.
export const prerender = false;

const url = new URL(Astro.request.url);
const host = Astro.request.headers.get('host') ?? Astro.url.host;
const origin = ssrRequestOrigin(Astro.url, host);

const lookup = await ssrEventGet<Event>({ id: url.searchParams.get('id') ?? '', host });
const event = lookup.status === 'found' ? lookup.event : null;
if (lookup.status === 'missing') Astro.response.status = 404;

// Hero and description images resolve against these entries first, so
// `/assets/<name>` (not served on ports) never reaches the HTML unresolved.
const siteManifest = event ? await ssrAssetManifest(origin) : null;
const assetManifest = event ? pickAssetManifestEntries(siteManifest, eventAssetUrls(event)) : null;
const description = event ? eventMetaDescription(event) : '';
const image = event ? eventOgImageUrl(event, siteManifest, origin) : '';
---

<Portal
  title={event?.title || 'Event'}
  pageSlug="event"
  robots={lookup.status === 'missing' ? 'noindex' : undefined}
  description={description || undefined}
  image={image || undefined}
>
  <div class="mx-auto w-full max-w-4xl px-4 py-8 sm:px-6 lg:px-8">
    <EventDetailPageApp initialEvent={event} assetManifest={assetManifest} client:load />
  </div>
</Portal>
